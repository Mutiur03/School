{
  "name": "school",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev --filter=server --filter=school-auth-bff --filter=@school/shared-schemas --filter=@school/common-ui --filter=dashboard",
    "dev:full": "turbo run dev --filter=server --filter=school-auth-bff --filter=@school/shared-schemas --filter=@school/common-ui --filter=dashboard --filter=client-next",
    "dev:minimal": "turbo run dev:single --filter=server --filter=school-auth-bff --filter=@school/shared-schemas --filter=@school/common-ui --filter=dashboard",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=@school/shared-schemas --filter=@school/common-ui",
    "build:apps": "turbo run build --filter=client-next --filter=dashboard --filter=server",
    "clean:ports": "pnpm exec kill-port 3002 3000 5174 5175 5176 5177 8787",
    "dev:server": "pnpm --filter server dev",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "dev:super_admin": "pnpm --filter dashboard dev:super_admin",
    "dev:auth-bff": "pnpm --filter school-auth-bff dev",
    "build:client:core": "turbo run build --filter=client-next",
    "build:client:cf": "turbo run build:cf --filter=client-next",
    "preview:client:cf": "turbo run build:cf --filter=client-next && pnpm --filter client-next preview:cf:only",
    "deploy:client:cf": "turbo run build:cf --filter=client-next && pnpm --filter client-next deploy:cf",
    "build:client": "pnpm install && pnpm run build:client:core",
    "dev:client": "pnpm --filter client-next dev",
    "dev:client-next": "pnpm --filter client-next dev",
    "build:dashboard:core": "turbo run build --filter=dashboard",
    "build:dashboard": "pnpm install && pnpm run build:dashboard:core",
    "build:common:ui": "turbo run build --filter=@school/common-ui",
    "dev:common:ui": "pnpm --filter @school/common-ui dev",
    "dev:shared-schemas": "pnpm --filter @school/shared-schemas dev",
    "build:server": "turbo run build --filter=server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node scripts/run-eslint.mjs",
    "lint:fix": "node scripts/run-eslint.mjs --fix",
    "check:server": "node scripts/ci-check.mjs server",
    "check:client-next": "node scripts/ci-check.mjs client-next",
    "check:dashboard": "node scripts/ci-check.mjs dashboard",
    "check:auth-bff": "node scripts/ci-check.mjs auth-bff",
    "check:tenant-router": "node scripts/ci-check.mjs tenant-router"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/archiver": "^7.0.0",
    "@typescript/typescript6": "6.0.2",
    "concurrently": "^9.2.1",
    "esbuild": "0.27.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^17.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.10.11",
    "typescript-eslint": "^8.67.0"
  }
}
