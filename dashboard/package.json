{
  "name": "dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n admin,student,teacher,super -c blue,green,magenta,yellow \"vite --mode admin --port 5174 --clearScreen false\" \"vite --mode student --port 5175 --clearScreen false\" \"vite --mode teacher --port 5176 --clearScreen false\" \"vite --mode super_admin --port 5177 --clearScreen false\"",
    "dev:dashboard": "vite --mode dashboard --port 5178 --clearScreen false",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:admin": "vite --mode admin --port 5174 --clearScreen false",
    "dev:student": "vite --mode student --port 5175 --clearScreen false",
    "dev:teacher": "vite --mode teacher --port 5176 --clearScreen false",
    "dev:super_admin": "vite --mode super_admin --port 5177 --clearScreen false",
    "build:admin": "tsc --noEmit && vite build --mode admin",
    "build:student": "tsc --noEmit && vite build --mode student",
    "build:teacher": "tsc --noEmit && vite build --mode teacher",
    "build:super_admin": "tsc --noEmit && vite build --mode super_admin"
  },
  "dependencies": {
