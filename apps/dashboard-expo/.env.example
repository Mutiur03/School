# Public, build-time configuration for dashboard-expo.
# Every EXPO_PUBLIC_* value is inlined into the JS bundle and readable by anyone who has the app.
# NEVER put secrets here (no JWT secrets, API keys, R2 credentials, Sentry auth tokens).
#
# Copy to .env.local for local development. For EAS builds, set these per environment with
# `eas env:create` (visibility: plain text) instead of committing them.

# local | staging | production
EXPO_PUBLIC_APP_ENV=local

# Origin of the API, without the trailing /api.
#   Web: leave empty to call same-origin /api (how the existing dashboard works behind the
#        tenant-router / auth-bff workers, which resolve the school from the hostname).
#   Native: optional. Set it only for a single-school build pinned to that school's dashboard
#        host; otherwise users pick their school with a school code (see DIRECTORY_URL).
EXPO_PUBLIC_API_BASE_URL=

# Origin that answers the pre-login school-code lookup (POST /api/school-code-lookups), e.g.
# https://apisms.example.com. After a code is confirmed the app talks to that school's own host.
# Native needs this or EXPO_PUBLIC_API_BASE_URL. Web defaults to same-origin.
EXPO_PUBLIC_DIRECTORY_URL=

# Public CDN origin used to turn stored R2 keys (school logo, photos) into URLs.
# Mirrors VITE_CDN_URL in the existing dashboard.
EXPO_PUBLIC_CDN_URL=

# Local development only: sent as the `x-tenant-host` header, which the backend reads only
# when NODE_ENV !== 'production'. Ignored unless EXPO_PUBLIC_APP_ENV=local.
EXPO_PUBLIC_DEV_TENANT_HOST=
