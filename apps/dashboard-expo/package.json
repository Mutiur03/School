{
  "name": "dashboard-expo",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "node ../../scripts/run-eslint.mjs apps/dashboard-expo",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "build:web": "expo export --platform web --output-dir dist/web",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "doctor": "npx --yes expo-doctor@1"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/metro-runtime": "~57.0.17",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@school/shared-schemas": "workspace:*",
    "@tanstack/react-query": "~5.101.4",
    "clsx": "^2.1.1",
    "expo": "~57.0.30",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.59.0",
    "nativewind": "4.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.16",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "zod": "^4.4.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    }
  }
}
