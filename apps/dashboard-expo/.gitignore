# Expo / Metro
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects are generated by `expo prebuild` (Continuous Native Generation)
android/
ios/

# Signing material and credentials must never be committed
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
google-services.json
GoogleService-Info.plist

# Local env files (the root .gitignore ignores .env*; keep the documented example)
.env*.local
!.env.example
