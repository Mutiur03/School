{
  "name": "client-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --disable-source-maps",
    "dev:webpack": "next dev --webpack --disable-source-maps",
    "build": "node scripts/next-build.mjs",
    "build:cf": "node scripts/run-with-open-next.mjs opennextjs-cloudflare build",
    "preview:cf:only": "node scripts/run-with-open-next.mjs opennextjs-cloudflare preview",
    "preview:cf": "node scripts/run-with-open-next.mjs opennextjs-cloudflare build && node scripts/run-with-open-next.mjs opennextjs-cloudflare preview",
    "deploy:cf": "node scripts/run-with-open-next.mjs opennextjs-cloudflare build && node scripts/run-with-open-next.mjs opennextjs-cloudflare deploy",
    "upload:cf": "node scripts/run-with-open-next.mjs opennextjs-cloudflare build && node scripts/run-with-open-next.mjs opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@school/common-ui": "workspace:*",
    "@school/shared-schemas": "workspace:*",
    "@swc/helpers": "0.5.15",
    "@tanstack/react-query": "^5.99.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.16.1",
    "lucide-react": "^1.8.0",
    "next": "^16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.0.0",
    "react-hot-toast": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.27.4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "wrangler": "^4.119.0"
  }
}
