{
  "exec": "node --import tsx/esm --import ./src/instrument.ts src/server.ts",
  "ext": "js,ts,json",
  "watch": ["src", "../packages/shared-schemas/dist"],
  "delay": "1000",
  "ignore": [
    "node_modules/**",
    "dist/**",
    "uploads/**",
    "logs/**",
    "**/*.log",
    "prisma/migrations/**",
    "../packages/**/node_modules/**"
  ]
}
