{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "src/server.ts",
  "scripts": {
    "preinstall": "pnpm --filter @school/shared-schemas build",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:nest": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:nest:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:nest:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "build": "prisma generate && nest build && tsc-alias",
    "db:migrate": "prisma generate && prisma migrate deploy",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:dev": "prisma migrate dev",
    "build:docker": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "backfill:class68-reg-pdfs": "tsx src/scripts/backfill-class68-reg-pdfs.ts",
    "dev": "node --watch-path=src --watch-path=../packages/shared-schemas/dist --import @swc-node/register/esm-register --import ./src/instrument.ts src/server.ts",
    "start": "node --import ./dist/instrument.js dist/server.js"
  },
  "keywords": [],
  "author": "Mutiur Rahman",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.972.0",
    "@aws-sdk/s3-request-presigner": "^3.972.0",
    "@getbrevo/brevo": "^2.2.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7",
    "@school/shared-schemas": "workspace:*",
    "@sentry/node": "^10.58.0",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "pdf-lib": "^1.17.1",
    "pdf-to-img": "^6.2.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.0",
    "prisma": "7",
    "puppeteer": "^24.33.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.4",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.13",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "@types/pdfkit": "^0.17.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)\\.js$": "<rootDir>/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "setupFiles": [
      "dotenv/config"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "forceExit": true
  }
}
